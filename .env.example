# Copy to .env.local. Only the public anon key belongs here; never put a service-role key in a VITE_ variable.
# Without these the site still works; the owner media panel and the enquiry form are simply disabled.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional company-owned aggregate analytics. URL is public; database credentials stay server-side.
# VITE_SITE_ANALYTICS_URL=https://YOUR-PROJECT.supabase.co/functions/v1/site-analytics
# Edge Function secrets: SITE_ORIGIN, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY

# Optional licensed metal market feed. SERVER-ONLY variables; never prefix with VITE_.
# MARKET_DATA_URL=https://YOUR-LICENSED-PROVIDER.example/api/quotes
# MARKET_DATA_TOKEN=SERVER-ONLY-PROVIDER-SECRET
# Verify vendor redistribution rights before enabling public display.

# Optional Supabase Storage public bucket with the same filenames as public/assets/images.
# Do not enable until all image URLs and cache/CORS behavior have been checked.
# VITE_MEDIA_BASE_URL=https://YOUR-PROJECT.supabase.co/storage/v1/object/public/company-images
