{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start private n8n and LiteLLM",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/start-local-services.sh",
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "local-services"
      },
      "problemMatcher": {
        "owner": "local-services",
        "pattern": [
          {
            "regexp": "^Ready:.*$",
            "message": 0
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Starting LiteLLM and n8n.*$",
          "endsPattern": "^Ready:.*$"
        }
      }
    }
  ]
}
