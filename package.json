{
  "name": "green-gemstone-mining",
  "private": true,
  "version": "1.0.0",
  "description": "Marketing and investor site for Green Gemstone Mining Company, Hargeisa, Somaliland.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-visual-editor-features.mjs && npm run typecheck && npm run lint && node --check public/visual-editor.js && node --check public/visual-editor/features/creative-studio.js && npm test && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run",
    "sync:media": "node scripts/sync-storage-to-db.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "dompurify": "^3.4.17",
    "lucide-react": "^0.446.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^16.4.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "supabase": "^2.122.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.2",
    "vercel": "^65.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "packageManager": "npm@10.9.4"
}
